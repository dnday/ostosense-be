NODE_ENV=production
PORT=3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_TOPIC=ostosense/sensor_data
# Opsional — cuma kepakai kalau di-set. Isi kalau broker Mosquitto sudah
# dikonfigurasi auth (username/password) atau TLS (MQTT_URL pakai mqtts://).
MQTT_USERNAME=
MQTT_PASSWORD=
# Set "true" HANYA buat testing TLS dengan self-signed cert. Jangan dipakai di lab/prod nyata.
MQTT_TLS_INSECURE=false
